# ─────────────────────────────────────────────────────────────
# WattFarm API configuration
# Copy to .env and fill in. The server validates all of this at
# boot and refuses to start when something is missing or malformed.
# ─────────────────────────────────────────────────────────────

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/wattfarm"

# Server port (default: 3001)
PORT=3001

# Set to "production" on deployed environments. Enables HSTS, hides error
# details, and makes CORS_ORIGINS + email verification mandatory.
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Required in production. Defaults to the Vite dev server locally.
# Must include the scheme. Example:
#   CORS_ORIGINS=https://wattfarm.app,https://www.wattfarm.app
CORS_ORIGINS=http://localhost:5173

# ── Proxy trust ───────────────────────────────────────────────
# Number of reverse proxies in front of this API.
#
# This decides whether the client IP is read from the socket or from the
# X-Forwarded-For header — and therefore whether IP-based rate limits can
# be forged. A client can put anything in that header, so trusting more
# hops than actually exist lets anyone reset their own rate-limit counter.
#
#   0 = trust nobody, use the socket address (correct when exposed directly,
#       and correct for local development). This is the default.
#   1 = one proxy in front (typical for Railway / Render / Fly / Heroku)
#   n = n proxies (e.g. Cloudflare in front of a platform proxy = 2)
TRUST_PROXY_HOPS=0

# ── Firebase Admin credential ─────────────────────────────────
# Set EXACTLY ONE of the three options below. Configuring more than
# one is rejected at boot so there is no ambiguity about which
# identity the server runs as.

# Option A — path to a service account JSON file (local development)
GOOGLE_APPLICATION_CREDENTIALS=

# Option B — the full service account JSON inline (hosted platforms).
# Newlines inside private_key must be escaped as \n.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option C — use ambient Application Default Credentials. Only enable
# where ADC genuinely exists (e.g. Cloud Run). Opt-in on purpose: this
# used to be a silent fallback that let the server boot and then fail
# on every login.
USE_APPLICATION_DEFAULT_CREDENTIALS=false

# ── Security toggles ──────────────────────────────────────────
# Ask Firebase whether a token was revoked on state-changing routes.
# Adds one round trip per mutating request but closes the window where
# a logged-out or disabled account keeps acting for up to an hour.
CHECK_REVOKED_TOKENS=true

# Require a verified email address for routes that earn or spend VLT.
#
# Secure by default: ENABLED unless you explicitly set it to "false".
# It used to default to "on only in production", which meant a deployment
# that forgot NODE_ENV silently ran with the check disabled.
#
# Local development usually wants this off, so the template ships with
# false — remember to remove it (or set true) in deployed environments.
REQUIRE_VERIFIED_EMAIL=false

# ── Testing only ──────────────────────────────────────────────
# Disables ALL rate limiters (global and per-route). Ignored when
# NODE_ENV=production. Logs a warning on boot when active.
DISABLE_RATE_LIMITS=false
