# Database connection (PostgreSQL on Railway)
DATABASE_URL="postgresql://user:password@host:5432/wattfarm"

# Server port
PORT=3001

# Firebase Admin SDK — choose ONE of the following:
# Option A: Path to serviceAccountKey.json (local dev)
GOOGLE_APPLICATION_CREDENTIALS=

# Option B: Paste the full JSON inline (good for Railway env vars)
FIREBASE_SERVICE_ACCOUNT_JSON=