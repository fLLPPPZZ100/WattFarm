generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id // firebase uid
  // Nullable: some Firebase providers (anonymous, phone) supply no address.
  // Postgres allows many NULLs under a unique index but only one '', so the
  // previous non-null default collided on the second such account.
  email           String?            @unique
  // Decimal, not Float: binary floating point cannot represent decimal
  // fractions exactly, so repeated credits/debits drifted. See lib/money.js.
  vltBalance      Decimal            @default(0) @db.Decimal(18, 4)
  avatarId        String             @default("default")
  unlockedAvatars String[]           @default(["default"])
  createdAt       DateTime           @default(now())
  assets          PlayerAsset[]
  minigameLogs    MinigameSession[]
  payouts         PlayerPayout[]
  ledger          LedgerEntry[]
  placedMounts    PlacedMount[]

  /// Code this player shares to invite others. Generated lazily on first sync
  /// (nullable so existing rows migrate without a backfill).
  referralCode        String?          @unique
  /// Who invited this player.
  ///
  /// Written once, during account creation, and never afterwards. Two reasons:
  /// reassigning it would let an established account be re-pointed at a new
  /// referrer to farm commissions, and because it can only be set at creation
  /// a referral cycle is structurally impossible — the referrer already existed
  /// when this row was made, so it cannot in turn be referred by this row.
  referredById        String?
  referredBy          User?            @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]           @relation("Referrals")
  /// One point per referral that has reached the qualifying milestone. Drives
  /// the referrer's level, which sets their commission rate.
  referralPoints      Int              @default(0)
  /// When this player qualified as somebody's referral. Null means their
  /// referrer earns nothing from them yet. Set once, so points are awarded once.
  referralQualifiedAt DateTime?

  referralEarned      ReferralReward[] @relation("ReferrerRewards")
  referralGenerated   ReferralReward[] @relation("ReferredRewards")

  @@index([referredById])
}

/// A referral payout, in VLT.
///
/// Both directions of the programme live here: the commission paid to a
/// referrer, and the one-off bonus paid to the person who joined. `beneficiary`
/// says which, because `amount` alone cannot distinguish them.
///
/// `(sourceKind, sourceId)` is unique so one mining payout can only ever produce
/// one commission. Idempotency is enforced by the database rather than by
/// application logic, because the payout cycle can be re-run manually and a
/// careful `findFirst` check would still race under concurrency.
model ReferralReward {
  id          String   @id @default(uuid())
  referrerId  String
  referredId  String
  /// "referrer" (commission) | "referred" (signup bonus)
  beneficiary String
  amount      Decimal  @db.Decimal(18, 4)
  /// Rate applied at the time, recorded so history stays explainable after the
  /// referrer levels up and their rate changes. Zero for the signup bonus.
  rateApplied Decimal  @default(0) @db.Decimal(6, 4)
  /// "mining-payout" | "signup-bonus"
  sourceKind  String
  /// The PlayerPayout id for a commission, the new user's id for a bonus.
  sourceId    String?
  createdAt   DateTime @default(now())

  referrer    User     @relation("ReferrerRewards", fields: [referrerId], references: [id])
  referred    User     @relation("ReferredRewards", fields: [referredId], references: [id])

  @@unique([sourceKind, sourceId])
  @@index([referrerId, createdAt])
  @@index([referredId, createdAt])
}

model AssetCatalog {
  type       String  @id // "solar" | "wind" | "hydro"
  basePrice  Decimal @db.Decimal(18, 4) // currency — exact
  multiplier Float // ratio, not currency
  baseW      Float // watts per second, a physical rate
}

model PlayerAsset {
  id            String   @id @default(uuid())
  userId        String
  type          String
  quantity      Int      @default(0)
  lastCollected DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

/// A mount placed on the farm grid.
///
/// The layout used to live only in the browser's localStorage, which meant two
/// things: the server had no idea what was placed (it computed output from the
/// quantity a player *owned*, so the grid was decorative), and the player could
/// rewrite it from the console. Now that mount tiers grant a power bonus, the
/// layout decides income and has to be server-authoritative.
///
/// `col`/`row` are the anchor cell — the leftmost cell for a multi-cell mount.
/// `panels` has one entry per bay, in slot order.
model PlacedMount {
  id        String   @id @default(uuid())
  userId    String
  type      String // "mount_single" | "mount_double"
  col       Int
  row       Int
  panels    Boolean[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  // One mount per anchor cell. Overlap of a multi-cell mount is checked in
  // application code, which knows how wide each type is.
  @@unique([userId, col, row])
  @@index([userId])
}

model MinigameSession {
  id           String   @id @default(uuid())
  userId       String
  game         String
  timestamp    DateTime @default(now())
  cooldownTier Int
  result       String   // "none" | "common" | "rare" | "epic"
  vltEarned    Decimal  @default(0) @db.Decimal(18, 4)
  user         User     @relation(fields: [userId], references: [id])

  // Cooldown checks query by (userId, game) ordered by timestamp on every
  // play and every status poll.
  @@index([userId, game, timestamp])
}

// MiningAllocation was removed with the wind and hydro networks. With a single
// energy source there was nothing to allocate, and the payout depended on a row
// that nothing ever created — so a player with a working farm earned nothing.

model PlayerPayout {
  id         String   @id @default(uuid())
  userId     String
  amount     Decimal  @db.Decimal(18, 4)
  details    String   // JSON string with breakdown per network
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}

/// Audit trail for currency-spending actions.
///
/// Purchases previously left no record, so an exploited balance could not be
/// reconstructed after the fact. Minigames and payouts already had their own
/// tables; this covers the debit side.
model LedgerEntry {
  id        String   @id @default(uuid())
  userId    String
  kind      String // "purchase" | "avatar-unlock"
  amount    Decimal  @db.Decimal(18, 4) // always positive; `kind` implies direction
  reference String? // asset type or avatar id
  quantity  Int      @default(1)
  balanceAfter Decimal @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}