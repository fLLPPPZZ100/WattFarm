generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id // firebase uid
  // Nullable: some Firebase providers (anonymous, phone) supply no address.
  // Postgres allows many NULLs under a unique index but only one '', so the
  // previous non-null default collided on the second such account.
  email           String?            @unique
  // Decimal, not Float: binary floating point cannot represent decimal
  // fractions exactly, so repeated credits/debits drifted. See lib/money.js.
  vltBalance      Decimal            @default(0) @db.Decimal(18, 4)
  avatarId        String             @default("default")
  unlockedAvatars String[]           @default(["default"])
  createdAt       DateTime           @default(now())

  /// Public invite code. Generated server-side from a CSPRNG, never derived
  /// from the uid or the email — a guessable code would let anyone enumerate
  /// accounts through the signup flow. See lib/referralCode.js.
  referralCode    String             @unique

  /// Who invited this player. Written exactly once, when the row is created,
  /// and never updated afterwards: allowing it to change later would let an
  /// established account be claimed retroactively by whoever asked last.
  referredById    String?
  referredAt      DateTime?
  referrer        User?              @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]             @relation("Referrals")

  commissionsEarned    ReferralCommission[] @relation("CommissionReferrer")
  commissionsGenerated ReferralCommission[] @relation("CommissionReferred")

  assets          PlayerAsset[]
  minigameLogs    MinigameSession[]
  payouts         PlayerPayout[]
  ledger          LedgerEntry[]
  placedMounts    PlacedMount[]

  // The commission run walks every referred player for a given day.
  @@index([referredById])
}

/// Purchasable assets and their prices.
///
/// Prices are fixed. There used to be a `multiplier` column driving exponential
/// pricing (cost rising with the quantity already owned); it was always 1, so
/// the escalation never took effect, and it has been removed along with the
/// geometric-series arithmetic that read it. An asset costs the same on the
/// first purchase as on the fiftieth.
model AssetCatalog {
  type  String  @id // "solar" | "panel-mount" | "panel-mount-double"
  price Decimal @db.Decimal(18, 4) // currency — exact
  baseW Float // watts per second, a physical rate
}

model PlayerAsset {
  id            String   @id @default(uuid())
  userId        String
  type          String
  quantity      Int      @default(0)
  lastCollected DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

/// A mount placed on the farm grid.
///
/// The layout used to live only in the browser's localStorage, which meant two
/// things: the server had no idea what was placed (it computed output from the
/// quantity a player *owned*, so the grid was decorative), and the player could
/// rewrite it from the console. Now that mount tiers grant a power bonus, the
/// layout decides income and has to be server-authoritative.
///
/// `col`/`row` are the anchor cell — the leftmost cell for a multi-cell mount.
/// `panels` has one entry per bay, in slot order.
model PlacedMount {
  id        String   @id @default(uuid())
  userId    String
  type      String // "mount_single" | "mount_double"
  col       Int
  row       Int
  panels    Boolean[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  // One mount per anchor cell. Overlap of a multi-cell mount is checked in
  // application code, which knows how wide each type is.
  @@unique([userId, col, row])
  @@index([userId])
}

model MinigameSession {
  id           String   @id @default(uuid())
  userId       String
  game         String
  timestamp    DateTime @default(now())
  cooldownTier Int
  result       String   // "none" | "common" | "rare" | "epic"
  vltEarned    Decimal  @default(0) @db.Decimal(18, 4)
  user         User     @relation(fields: [userId], references: [id])

  // Cooldown checks query by (userId, game) ordered by timestamp on every
  // play and every status poll.
  @@index([userId, game, timestamp])
}

model PlayerPayout {
  id         String   @id @default(uuid())
  userId     String
  amount     Decimal  @db.Decimal(18, 4)
  // JSON string with the breakdown: power rate, baseline, budget, payout.
  // Rows written before the multi-network model was removed also carry
  // `network` and `percentage`.
  details    String
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}

/// One day's referral commission, for one referrer/referred/kind triple.
///
/// ## Why the day is part of the row, and part of the unique key
///
/// Commissions are settled once per UTC day for the previous day's activity,
/// which means the job is a batch that can be retried — after a crash, a
/// deployment in the middle of a run, or a manual re-run from
/// `scripts/run-referral-commissions.mjs`. Without a natural key the retry
/// would pay the same day twice.
///
/// `@@unique([referrerId, referredId, kind, periodDate])` makes double payment
/// a database error rather than a silent duplicate, so the runner can insert
/// optimistically and treat a unique violation as "already settled".
///
/// `sourceAmount` and `rate` are stored alongside `amount` so a commission can
/// be audited without recomputing it from tables that may have moved on.
model ReferralCommission {
  id           String   @id @default(uuid())
  referrerId   String
  referredId   String
  kind         String // "mining" | "purchase"
  /// UTC day the underlying activity happened, at midnight.
  periodDate   DateTime
  /// Total the referred player earned (mining) or spent (purchases) that day.
  sourceAmount Decimal  @db.Decimal(18, 4)
  /// Commission fraction applied, recorded per row so a later rate change does
  /// not rewrite history.
  rate         Float
  amount       Decimal  @db.Decimal(18, 4)
  createdAt    DateTime @default(now())

  referrer User @relation("CommissionReferrer", fields: [referrerId], references: [id])
  referred User @relation("CommissionReferred", fields: [referredId], references: [id])

  @@unique([referrerId, referredId, kind, periodDate])
  @@index([referrerId, createdAt])
  @@index([referredId, periodDate])
}

/// Audit trail for currency-spending actions.
///
/// Purchases previously left no record, so an exploited balance could not be
/// reconstructed after the fact. Minigames and payouts already had their own
/// tables; this covers the debit side.
model LedgerEntry {
  id        String   @id @default(uuid())
  userId    String
  // "purchase" | "avatar-unlock" | "referral-commission"
  // Historical rows may also carry "grid-expansion", from a feature that was
  // removed. The ledger is an audit trail, so those entries are kept.
  kind      String
  // Always positive; `kind` implies direction. Everything here was a debit until
  // "referral-commission", which is a credit — so read the sign from `kind`,
  // never from the value.
  amount    Decimal  @db.Decimal(18, 4)
  reference String? // asset type or avatar id
  quantity  Int      @default(1)
  balanceAfter Decimal @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}